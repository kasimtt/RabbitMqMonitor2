<Window x:Class="RabbitMqMonitor.Views.ServerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RabbitMQ Server Profile"
        Icon="pack://application:,,,/Assets/rabbitmq.ico"
        Width="480"
        Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="DialogTitleText"
                       Text="Add RabbitMQ Server Profile"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#F8FAFC"/>
            <TextBlock Text="Credentials are encrypted locally using Windows DPAPI (CurrentUser)."
                       FontSize="12"
                       Foreground="#94A3B8"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Profile Name" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

                <TextBlock Text="Management API Host URL (e.g., http://192.168.1.10:15672)" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="HostUrlTextBox" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Username" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="UsernameTextBox" Style="{StaticResource DarkTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Password (DPAPI Encrypted)" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="PasswordInput"
                                     Background="#1E293B"
                                     Foreground="#F8FAFC"
                                     BorderBrush="#334155"
                                     BorderThickness="1"
                                     Padding="8,6"
                                     CaretBrush="#38BDF8"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Virtual Host (default '/' or '*' for all vhosts)" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="VhostTextBox" Style="{StaticResource DarkTextBoxStyle}" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Refresh Interval (seconds)" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="RefreshIntervalTextBox" Style="{StaticResource DarkTextBoxStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Queue Alert Threshold" Foreground="#CBD5E1" FontSize="12" Margin="0,0,0,4"/>
                        <TextBox x:Name="AlertThresholdTextBox" Style="{StaticResource DarkTextBoxStyle}"/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="IsEnabledCheckBox"
                          Content="Enable live polling for this server"
                          Foreground="#E2E8F0"
                          Margin="0,6,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel"
                    Width="95"
                    Margin="0,0,10,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button Content="Save Server"
                    Width="120"
                    Style="{StaticResource PrimaryButtonStyle}"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>

